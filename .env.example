# Django secret; replace this placeholder before use.
DJANGO_SECRET_KEY=replace-with-a-random-development-secret
# Django debug mode; use True only for local development.
DEBUG=True
# Comma-separated hosts accepted by Django.
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated browser origins allowed by Django CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Facebook application key for the Django social-auth backend.
SOCIAL_AUTH_FACEBOOK_KEY=replace-with-facebook-app-id
# Facebook application secret for the Django social-auth backend.
SOCIAL_AUTH_FACEBOOK_SECRET=replace-with-facebook-app-secret
# Browser destination after Facebook social login.
SOCIAL_AUTH_LOGIN_REDIRECT_URL=http://localhost:5173/
# Facebook app ID used by the React login component.
VITE_FACEBOOK_APP_ID=replace-with-facebook-app-id
# OAuth client ID used by frontend token requests.
VITE_CLIENT_ID=replace-with-oauth-client-id
# OAuth client secret currently read by frontend code; it is exposed in the browser bundle.
VITE_CLIENT_SECRET=replace-with-oauth-client-secret
# OAuth grant type; frontend defaults to password when unset.
VITE_GRANT_TYPE=password
# Intended API origin for the Facebook helper; currently read with an incorrect Vite property path.
VITE_API_BASE_URL=http://127.0.0.1:8000
